{
  "name": "iris",
  "private": true,
  "version": "0.2.7",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @iris/desktop dev",
    "desktop": "pnpm --filter @iris/desktop tauri dev",
    "build": "pnpm -r build",
    "build:binary": "pnpm --filter @iris/desktop tauri build --no-bundle",
    "build:desktop": "pnpm --filter @iris/desktop tauri build",
    "build:appimage": "pnpm --filter @iris/desktop tauri build --bundles appimage",
    "build:appimage:container": "bash scripts/build-appimage-container.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
